filters:
  and:
    - note.categories.contains(link("Admin"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Name
  note.status:
    displayName: Status
  note.created:
    displayName: Created
views:
  - type: table
    name: Table
    order:
      - file.name
      - status
      - created
    sort:
      - property: created
        direction: DESC
